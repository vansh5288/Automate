APP_ENV=development
LOG_LEVEL=INFO

DATABASE_URL=sqlite:///./procureflow.db

NOTION_TOKEN=
NOTION_REQUESTS_DATABASE_ID=
NOTION_APPROVALS_DATABASE_ID=
